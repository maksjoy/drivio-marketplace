NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Cloudflare Turnstile site key (public). Leave this unset until the widget exists.
# The login page reads it on the server: when it is empty, the widget is not rendered
# and /api/auth does not require a token. Do not put the Turnstile secret in Vercel.
# Paste that secret only into the Supabase Auth CAPTCHA setting, and only after the
# widget is visible and sign-in still works. See README.md, "Auth CAPTCHA and rate limits".
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Upstash Redis REST credentials for auth rate limits (server-only). If either value
# is unset, limiting is skipped and the server logs one warning. Sign-in keeps working.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional production monitoring. Keep SENTRY_AUTH_TOKEN server-side only.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
