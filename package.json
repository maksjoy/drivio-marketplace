{
  "name": "alberta-cars",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/unit/*.test.mjs",
    "test:security-live": "node --test tests/security-live.test.cjs",
    "test:e2e": "playwright test",
    "test": "npm run typecheck && npm run test:unit && npm run test:security-live",
    "load:smoke": "node ops/load-smoke.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@sentry/nextjs": "10.76.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.2",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "postcss": "8.5.32"
  }
}
