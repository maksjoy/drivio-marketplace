{
  "name": "alberta-cars",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test:unit": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/unit/*.test.mjs",
    "test:security-live": "node --test tests/security-live.test.cjs",
    "test:e2e": "playwright test",
    "test": "npm run typecheck && npm run test:unit && npm run test:security-live",
    "load:smoke": "node ops/load-smoke.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.5",
    "@sentry/nextjs": "10.76.2",
    "@supabase/ssr": "0.5.2",
    "@supabase/supabase-js": "2.118.0",
    "next": "15.5.28",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "autoprefixer": "10.4.19",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "5.5.4"
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "postcss": "8.5.31"
  }
}
